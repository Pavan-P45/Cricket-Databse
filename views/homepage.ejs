</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
$("#playerButton").click( (e)=>{ 
    $(".playersContent").toggleClass("visible");
});

$("#teamButton").click( (e)=>{ 
    $(".teamContent").toggleClass("visible");
});

$("#wk").click( (e)=>{ 
    $(".wkContent").toggleClass("visible");
});

$("#captainButton").click( (e)=>{ 
    $(".captainContent").toggleClass("visible");
});

$("#umpireButton").click( (e)=>{ 
    $(".umpireContent").toggleClass("visible");
});

$("#stadiumButton").click( (e)=>{ 
    $(".stadiumContent").toggleClass("visible");
});
</script>