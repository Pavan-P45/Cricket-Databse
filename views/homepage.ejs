            </th>
        </tr>
        <div class="wkContent">
            <tr class="wkContent">
                <td class="wkContent">team id</td>
                <td class="wkContent">Wicket Keeper Name</td>
                <td class="wkContent">Country Name</td>
                <td class="wkContent">Catches</td>
                <td class="wkContent">Stumpings</td>
            </tr>
            <%  for(let i=0;i<wk.length;i++){%>
            <tr class="wkContent">
                <td class="wkContent"><%= wk[i].team_id %></td>
                <td class="wkContent"><%= wk[i].wk_name %></td>
                <td class="wkContent"><%= wk[i].country_name %></td>
                <td class="wkContent"><%= wk[i].catches %></td>
                <td class="wkContent"><%= wk[i].wk_stumpings%></td>
            </tr>
        </div>
        <%}%>
    </table>
</div>
