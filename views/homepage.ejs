<link rel="stylesheet" href="./homepage.css">

<div class="bg"></div>

<div id="navbar">
    <a href="#players">Players</a>
    <a href="#teams">Team</a>
    <a href="#wk">Wicket Keeper</a>
    <a href="#captains">Captain</a>
    <a href="#umpire">Umpire</a>
    <a href="#coach">Coach</a>
    <a href="#stadium">Stadium</a>
</div>

<div id="players">
    <table>
        <tr>
            <th colspan="3">PLAYERS</th>
            <th colspan="5">SEARCH
                    <div class="top">
                        <form action="/player" method="post">
                            <input type="text" id="playerSearch" name="player" />
                            <input type="submit"></input>
                        </form>
                        <button id="playerButton">▼</button>
                    </div>
            </th>
            <th colspan="7">
                <p>
                    1-India <br>
                    2-Australia <br>
                    3-England <br>
                    4-New Zealand <br>
                    5-South Africa <br>
                </p>
            </th>
        </tr>
            <tr class="playersContent">
                <td class="playersContent">Player ID</td>
                <td class="playersContent">Team ID</td>
                <td class="playersContent">Player Name</td>
                <td class="playersContent">number of matches</td>
                <td class="playersContent">number of runs</td>
                <td class="playersContent">number of wickets</td>
                <td class="playersContent">type of bowler</td>
                <td class="playersContent">economy</td>
                <td class="playersContent">ODI</td>
                <td class="playersContent">Test</td>
                <td class="playersContent">T20</td>
                <td class="playersContent">50s</td>
                <td class="playersContent">100s</td>
                <td class="playersContent">Type of Batsmen</td>
                <td class="playersContent">Strike Rate</td>
            </tr>
            <%  for(let i=0;i<player.length;i++){%>
            <tr class="playersContent">
                <td class="playersContent">
                    <%= player[i].player_id %>
                </td>
                <td class="playersContent"><%= player[i].team_id %></td>
                <td class="playersContent"><%= player[i].player_name %></td>
                <td class="playersContent"><%= player[i].no_of_matches %></td>
                <td class="playersContent"><%= player[i].no_of_runs %></td>
                <td class="playersContent"><%= player[i].no_of_wickets %></td>
                <td class="playersContent"><%= player[i].type_of_bowler %></td>
                <td class="playersContent"><%= player[i].economy %></td>
                <td class="playersContent"><%= player[i].odi %></td>
                <td class="playersContent"><%= player[i].test %></td>
                <td class="playersContent"><%= player[i].t20 %></td>
                <td class="playersContent"><%= player[i].fifty %></td>
                <td class="playersContent"><%= player[i].hundred %></td>
                <td class="playersContent"><%= player[i].type_of_batsmen %></td>
                <td class="playersContent"><%= player[i].strike_rate %></td>
            </tr>
    <%}%>
    </table>
</div>

<div id="teams">
    <table>
        <tr>
            <th colspan="1">TEAMS</th>
            <th colspan="3">SEARCH
                <div class="top">
                    <form action="/team" method="post">
                        <input type="text" id="teamSearch" name="team" />
                        <input type="submit"></input>
                    </form>
                    <button id="teamButton">▼</button>
                </div>
            </th>
        </tr>
        <div class="teamContent">
            <tr class="teamContent">
                <td class="teamContent">Team ID</td>
                <td class="teamContent">Rank</td>
                <td class="teamContent">Team Name</td>
                <td class="teamContent">Country Name</td>
            </tr>
            <%  for(let i=0;i<team.length;i++){%>
            <tr class="teamContent">
                <td class="teamContent"><%= team[i].team_id %></td>
                <td class="teamContent"><%= team[i].rank %></td>
                <td class="teamContent"><%= team[i].team_name %></td>
                <td class="teamContent"><%= team[i].country_name %></td>
            </tr>
        </div>
        <%}%>
    </table>
</div>

