                <td class="captainContent"><%= captain[i].captain_id %></td>
                <td class="captainContent"><%= captain[i].captain_name %></td>
                <td class="captainContent"><%= captain[i].years_of_captaincy %></td>
                <td class="captainContent"><%= captain[i].no_of_wins %></td>
            </tr>
        </div>
        <%}%>
    </table>
</div>

<div id="umpire">
    <table>
        <tr>
